# ---------------------------------------------------------------------------
# Copy this file to config/application-local.yml and fill in the real values.
#
#     cp config/application-local.yml.example config/application-local.yml
#
# config/application-local.yml is listed in .gitignore and must never be
# committed: it holds the Oracle credentials.
# ---------------------------------------------------------------------------
spring:
  datasource:
    # Oracle SID style URL:  jdbc:oracle:thin:@<host>:<port>:<sid>
    # Oracle service-name style: jdbc:oracle:thin:@//<host>:<port>/<service>
    url: jdbc:oracle:thin:@HOST:1521:SID
    username: CHANGE_ME
    password: CHANGE_ME

# 사내 LLM API 주소·모델명은 여기가 아니라 ai-model/.env 에 둔다.
#   cp ai-model/.env.example ai-model/.env
